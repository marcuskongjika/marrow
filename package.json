{
  "name": "marrow",
  "productName": "Marrow",
  "version": "0.1.0",
  "description": "A fast, beautiful desktop Markdown viewer. Read your notes down to the bone.",
  "author": {
    "name": "Marrow Contributors"
  },
  "license": "MIT",
  "homepage": "https://github.com/your-org/marrow",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/marrow.git"
  },
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/hast": "3.0.5",
    "@types/katex": "0.16.8",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "chokidar": "5.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "github-slugger": "2.0.0",
    "globals": "17.13.0",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-to-text": "4.0.2",
    "katex": "0.16.47",
    "mermaid": "12.1.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
